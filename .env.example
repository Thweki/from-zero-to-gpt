# Server-only settings. Never use VITE_ for secrets.
TUTOR_PROVIDER=OpenCode Go
TUTOR_BASE_URL=https://opencode.ai/inference/go/openai/v1
TUTOR_MODEL=deepseek-v4.1-flash
# Keep 0 for the current text model. Set 1 ONLY after configuring a model and
# OpenAI-compatible endpoint verified to support image_url content blocks.
TUTOR_SUPPORTS_IMAGES=0
TUTOR_API_KEY=
# Optional access code for a publicly reachable self-hosted proxy.
TUTOR_ACCESS_TOKEN=
# Set to 1 only if intentionally using http://localhost for your own model server.
TUTOR_ALLOW_LOCAL_HTTP=0

# For a Node proxy behind your own HTTPS reverse proxy, set the public origin.
TUTOR_PUBLIC_ORIGIN=
