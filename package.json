{
  "name": "from-zero-to-gpt",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/package-projects.mjs && vite --host 0.0.0.0",
    "build": "tsc -b && node scripts/copy-python.mjs && node scripts/package-projects.mjs && vite build && node scripts/build-server.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc -b",
    "postinstall": "node scripts/copy-python.mjs",
    "validate:course": "node scripts/validate-course.mjs",
    "start": "node --env-file-if-exists=.env scripts/serve.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "pyodide": "0.27.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
